NODE_ENV=production
PORT=3000
APP_ORIGIN=https://presencas.seu-dominio.org.br
# Copie do Supabase: Connect > Session pooler, porta 5432; guarde como segredo.
DATABASE_URL=postgresql://postgres.REF:SENHA_ESCAPADA@HOST.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Opcional: certificado CA oficial, se exigido pelo provedor. Nunca desabilite validação TLS.
DATABASE_CA_CERT=
GOOGLE_CLIENT_ID=SUBSTITUIR.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SUBSTITUIR
# Somente para criar o primeiro administrador via npm run bootstrap
BOOTSTRAP_ADMIN_EMAIL=administrador@ensinabrasil.org
# JSON da conta de serviço, em variável secreta do provedor. Não criar arquivo no projeto.
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
SHEETS_ID=SUBSTITUIR
TIME_ZONE=America/Sao_Paulo
SYNC_INTERVAL_MS=60000
# inline: sincroniza no próprio site; manual: somente pelo botão do ADMIN
SHEETS_SYNC_MODE=inline

# Época do evento, inclusive (datas locais no TIME_ZONE)
EVENT_START_DATE=2027-01-11
EVENT_END_DATE=2027-01-16
